{
  "name": "vmix-pose-tracker",
  "version": "1.0.0",
  "description": "PWA que detecta y rastrea personas (pose) en la cámara del móvil, 100% local, y emite un enlace WebRTC para usar como fuente Web Browser en vMix.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/fetch-assets.mjs",
    "fetch:assets": "node scripts/fetch-assets.mjs",
    "dev": "vite --host",
    "prebuild": "node scripts/fetch-assets.mjs --strict",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.1"
  }
}
